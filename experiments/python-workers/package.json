{
  "name": "celld-python-host-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && npm run build:session",
    "build:session": "PYTHON_FIXTURE_ENTRY=session-worker.js PYTHON_FIXTURE_OUTPUT=dist/session.js PYTHON_BUILD_OUTPUT_DIR=dist PYTHON_PACKAGES_ROOT=fixtures/session-packages node build.mjs",
    "test": "node --test --test-concurrency=2 python-host.node.test.mjs session.test.mjs microtask-contract.test.mjs",
    "test:host": "node --test python-host.node.test.mjs",
    "test:session": "node --test session.test.mjs",
    "test:baseline": "node --test --test-concurrency=2 smoke.test.mjs transaction-contract.test.mjs async-wasm.test.mjs",
    "probe:v050-lifecycle": "node --test resources.test.mjs durable.test.mjs pool-lifecycle.test.mjs",
    "probe:interrupt-mechanism": "node probes/interrupt-mechanism.mjs",
    "test:packages": "node --test packages.test.mjs",
    "test:microtask": "node --test microtask-contract.test.mjs",
    "test:websocket-pair": "node --test websocket-pair-contract.test.mjs"
  },
  "dependencies": {
    "pyodide": "0.28.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20260921.0-alpha",
    "workerd": "1.20260922.1",
    "ws": "8.21.3"
  }
}
